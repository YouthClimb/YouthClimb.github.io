---
import '../styles/global.css';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  published?: Date;
  updated?: Date;
}
const {
  title,
  description = site.description,
  image = '/media/banner.jpg',
  article = false,
  published,
  updated,
} = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · 我们的共同记录`;
const canonical = new URL(Astro.url.pathname.replace(/index\.html$/, ''), Astro.site);
const path = decodeURI(Astro.url.pathname);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f7f2" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" href="/atom.xml" title={site.name} type="application/atom+xml" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <header class="site-header">
      <div class="header-inner container">
        <a class="brand" href="/" aria-label="YouthClimb 首页">
          <span class="brand-mark">
            <Icon name="mountain" size={25} />
          </span>
          <span>
            YouthClimb<span class="brand-dot">.</span>
          </span>
        </a>
        <nav class="desktop-nav" aria-label="主导航">
          {site.navigation.map((item) => (
            <a
              href={item.href}
              aria-current={
                (
                  item.href === '/'
                    ? path === '/' || path.startsWith('/page/')
                    : path.startsWith(item.href) ||
                      (item.href === '/novels/' &&
                        (path.startsWith('/books/') || path.startsWith('/categories/小说')))
                )
                  ? 'page'
                  : undefined
              }
            >
              {item.label}
            </a>
          ))}
        </nav>
        <div class="header-actions">
          <a class="search-link" href="/search/" aria-label="搜索记录">
            <Icon name="search" />
            <span>搜索</span>
            <kbd>⌘ K</kbd>
          </a>
          <details class="mobile-menu">
            <summary aria-label="打开导航">
              <Icon name="menu" />
            </summary>
            <nav aria-label="移动导航">
              {site.navigation.map((item) => (
                <a href={item.href}>{item.label}</a>
              ))}
              <a href="/atom.xml">RSS 订阅</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer container">
      <div>
        <a class="footer-brand" href="/">
          YouthClimb.
        </a>
        <p>一起向上，也一起玩耍。</p>
      </div>
      <div class="footer-right">
        <span>
          © {site.since}–{new Date().getFullYear()} Climbing & Playing
        </span>
        <a href="/atom.xml">
          <Icon name="rss" size={15} /> 全站订阅
        </a>
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Built with Astro ↗
        </a>
      </div>
    </footer>
    <script>
      document.addEventListener('keydown', (event) => {
        if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          const input = document.querySelector<HTMLInputElement>('#search-input');
          if (input) input.focus();
          else window.location.href = '/search/';
        }
      });
    </script>
  </body>
</html>
